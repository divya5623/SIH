# =============================================
# AWAAZ SARPANCH — Environment Configuration
# =============================================
# Copy this file to .env and fill in your keys

# --- Bhashini ULCA API (FREE - Government of India) ---
# Register at: https://bhashini.gov.in/ulca/user/register
# After login go to: My Profile > API Key
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here

# --- Google Gemini API (FREE 1M tokens/month) ---
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- App Settings ---
# Set to "true" in production
DEBUG=true
FRONTEND_URL=http://localhost:5173
